{
  "cosmos-installer": {
    "skip-default-network": true,
    "frozen-volumes": [
      "{ServiceName}-data",
      "{ServiceName}-postgres-data"
    ],
    "form": [
      {
        "type": "info",
        "label": "The hostname selected for the Synapse route becomes the permanent Matrix server name. Matrix user IDs and room aliases retain this identity for the lifetime of the database."
      },
      {
        "name": "adminUser",
        "label": "Initial Matrix administrator username",
        "initialValue": "admin",
        "type": "text"
      },
      {
        "name": "adminPassword",
        "label": "Initial Matrix administrator password (required)",
        "initialValue": "",
        "type": "password"
      },
      {
        "name": "reportStats",
        "label": "Send anonymous usage statistics to the Synapse project?",
        "initialValue": "no",
        "type": "select",
        "options": [
          [
            "No",
            "no"
          ],
          [
            "Yes",
            "yes"
          ]
        ]
      },
      {
        "name": "maxUploadSize",
        "label": "Maximum media upload size",
        "initialValue": "100M",
        "type": "text"
      }
    ],
    "post-install": [
      {
        "type": "success",
        "label": "Synapse, PostgreSQL, federation on HTTPS port 443, client discovery, and the initial administrator are configured automatically. The administrator bootstrap container exits after succeeding; this is expected."
      },
      {
        "type": "warning",
        "label": "TURN is not included. Messaging and federation work without it, but reliable voice and video calls require a separately deployed Coturn service."
      },
      {
        "type": "info",
        "label": "Back up both the PostgreSQL database and the Synapse data volume. Copying only one of them is not a complete Matrix backup."
      }
    ]
  },
  "minVersion": "0.22.29",
  "services": {
    "{ServiceName}-postgres": {
      "image": "postgres:17.10-alpine3.23",
      "container_name": "{ServiceName}-postgres",
      "hostname": "{ServiceName}-postgres",
      "restart": "unless-stopped",
      "stop_grace_period": 30,
      "environment": [
        "POSTGRES_DB=synapse",
        "POSTGRES_USER=synapse",
        "POSTGRES_PASSWORD={Passwords.0}",
        "POSTGRES_INITDB_ARGS=--encoding=UTF-8 --lc-collate=C --lc-ctype=C"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U synapse -d synapse"
        ],
        "interval": 5,
        "timeout": 5,
        "retries": 30,
        "start_period": 10
      },
      "volumes": [
        {
          "source": "{ServiceName}-postgres-data",
          "target": "/var/lib/postgresql/data",
          "type": "volume"
        }
      ],
      "networks": {
        "{ServiceName}-database": {}
      },
      "labels": {
        "cosmos-persistent-env": "POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_INITDB_ARGS",
        "cosmos-auto-update": "true",
        "cosmos-icon": "https://azukaar.github.io/cosmos-servapps-official/servapps/Synapse/icon.svg",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}"
      }
    },
    "{ServiceName}": {
      "image": "matrixdotorg/synapse:v1.157.0",
      "container_name": "{ServiceName}",
      "hostname": "{ServiceName}",
      "restart": "unless-stopped",
      "stop_grace_period": 60,
      "entrypoint": "/bin/sh -c",
      "command": "printf${IFS}%s${IFS}|base64${IFS}-d|/bin/sh",
      "depends_on": {
        "{ServiceName}-postgres": {
          "condition": "service_started"
        }
      },
      "environment": [
        "TZ=auto",
        "UID=991",
        "GID=991",
        "SYNAPSE_SERVER_NAME={Hostnames.{StaticServiceName}.{StaticServiceName}.host}",
        "SYNAPSE_PUBLIC_BASEURL=https://{Hostnames.{StaticServiceName}.{StaticServiceName}.host}/",
        "SYNAPSE_REPORT_STATS={Context.reportStats}",
        "SYNAPSE_NO_TLS=yes",
        "SYNAPSE_HTTP_PORT=8008",
        "SYNAPSE_MAX_UPLOAD_SIZE={Context.maxUploadSize}",
        "SYNAPSE_REGISTRATION_SHARED_SECRET={Passwords.1}",
        "SYNAPSE_MACAROON_SECRET_KEY={Passwords.2}",
        "POSTGRES_HOST={ServiceName}-postgres",
        "POSTGRES_PORT=5432",
        "POSTGRES_DB=synapse",
        "POSTGRES_USER=synapse",
        "POSTGRES_PASSWORD={Passwords.0}"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-fSs",
          "http://localhost:8008/health"
        ],
        "interval": 15,
        "timeout": 5,
        "retries": 20,
        "start_period": 60
      },
      "volumes": [
        {
          "source": "{ServiceName}-data",
          "target": "/data",
          "type": "volume"
        }
      ],
      "networks": {
        "{ServiceName}-database": {}
      },
      "labels": {
        "cosmos-network-name": "AUTO",
        "cosmos-persistent-env": "SYNAPSE_SERVER_NAME, SYNAPSE_PUBLIC_BASEURL, SYNAPSE_REPORT_STATS, SYNAPSE_MAX_UPLOAD_SIZE, SYNAPSE_REGISTRATION_SHARED_SECRET, SYNAPSE_MACAROON_SECRET_KEY, POSTGRES_HOST, POSTGRES_PORT, POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD",
        "cosmos-auto-update": "true",
        "cosmos-icon": "https://azukaar.github.io/cosmos-servapps-official/servapps/Synapse/icon.svg",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}"
      },
      "routes": [
        {
          "name": "{ServiceName}",
          "description": "Matrix client and federation endpoint",
          "useHost": true,
          "target": "http://{ServiceName}:8008",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "AuthEnabled": false,
          "AdminOnly": false,
          "BlockCommonBots": false,
          "BlockAPIAbuse": false,
          "SmartShield": {
            "Enabled": false
          }
        }
      ]
    },
    "{ServiceName}-bootstrap-admin": {
      "image": "matrixdotorg/synapse:v1.157.0",
      "container_name": "{ServiceName}-bootstrap-admin",
      "hostname": "{ServiceName}-bootstrap-admin",
      "entrypoint": "/bin/sh -c",
      "command": "printf${IFS}%s${IFS}|base64${IFS}-d|/bin/sh",
      "depends_on": {
        "{ServiceName}": {
          "condition": "service_started"
        }
      },
      "environment": [
        "ADMIN_USER={Context.adminUser}",
        "ADMIN_PASSWORD={Context.adminPassword}",
        "SYNAPSE_SERVER_NAME={Hostnames.{StaticServiceName}.{StaticServiceName}.host}",
        "SYNAPSE_HOST={ServiceName}",
        "SYNAPSE_PORT=8008"
      ],
      "volumes": [
        {
          "source": "{ServiceName}-data",
          "target": "/data",
          "type": "volume"
        }
      ],
      "networks": {
        "{ServiceName}-database": {}
      },
      "labels": {
        "cosmos-persistent-env": "ADMIN_USER, ADMIN_PASSWORD, SYNAPSE_SERVER_NAME, SYNAPSE_HOST, SYNAPSE_PORT",
        "cosmos-icon": "https://azukaar.github.io/cosmos-servapps-official/servapps/Synapse/icon.svg",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}"
      }
    }
  },
  "networks": {
    "{ServiceName}-database": {
      "internal": true
    }
  }
}
